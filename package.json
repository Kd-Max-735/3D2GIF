{
  "name": "orbitframe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "dist/orbitframe.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/orbitframe.js"
    },
    "./schema": "./src/schema/orbitframe.schema.json"
  },
  "files": ["dist", "src/schema/orbitframe.schema.json", "README.md", "docs"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:performance": "playwright test -g \"512x512|releases repeated\"",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.0",
    "gifuct-js": "^2.1.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
